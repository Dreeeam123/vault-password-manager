<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/vault_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/vault_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- The real activity has no launcher entry. Exactly one of the aliases below is enabled at a
             time; AppIconPlugin switches them so the home-screen icon follows the in-app theme. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:icon="@mipmap/vault_launcher"
            android:roundIcon="@mipmap/vault_launcher_round"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true" />

        <activity-alias android:name=".LauncherClassic" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher" android:roundIcon="@mipmap/vault_launcher_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGlass" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_glass" android:roundIcon="@mipmap/vault_launcher_glass_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherGradient" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_gradient" android:roundIcon="@mipmap/vault_launcher_gradient_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherMidnight" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_midnight" android:roundIcon="@mipmap/vault_launcher_midnight_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherForest" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_forest" android:roundIcon="@mipmap/vault_launcher_forest_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherRose" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_rose" android:roundIcon="@mipmap/vault_launcher_rose_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherMono" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_mono" android:roundIcon="@mipmap/vault_launcher_mono_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherOcean" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_ocean" android:roundIcon="@mipmap/vault_launcher_ocean_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherAmber" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:label="@string/title_activity_main" android:icon="@mipmap/vault_launcher_amber" android:roundIcon="@mipmap/vault_launcher_amber_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

</manifest>
