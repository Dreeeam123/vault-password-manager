{
  "name": "vault-password-manager",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/generate-icons.mjs && next dev",
    "build": "node scripts/generate-icons.mjs && next build && node scripts/build-offline.mjs",
    "start": "serve out -l 3000",
    "test": "tsx --test tests/*.test.ts",
    "android:sync": "pnpm build && cap sync android",
    "android:debug": "pnpm android:sync && cd android && sh ./gradlew assembleDebug --no-daemon",
    "desktop:start": "pnpm build && pnpm --dir desktop start",
    "desktop:dist": "pnpm build && pnpm --dir desktop dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.8",
    "postcss": "^8.5.33",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
